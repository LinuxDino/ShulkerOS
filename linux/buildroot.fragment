# Shulker Linux on top of fnuecke/buildroot (branch sedna), merged into sedna-riscv64_defconfig
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SHULKER_PATH)/board/linux.fragment"
BR2_ROOTFS_OVERLAY="board/sedna-riscv64/rootfs-overlay $(BR2_EXTERNAL_SHULKER_PATH)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/sedna-riscv64/post-build.sh $(BR2_EXTERNAL_SHULKER_PATH)/post-build.sh"
# OC2 hard drives take the size of their image (servers cap a drive at 16 MB by default)
BR2_TARGET_ROOTFS_EXT2_SIZE="16M"
# several programs at once in one terminal
BR2_PACKAGE_TMUX=y
# RAID over the computer's 4 drive bays
BR2_PACKAGE_MDADM=y
# HTTPS that verifies certificates: curl + BearSSL + the Mozilla CA bundle
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_BEARSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
