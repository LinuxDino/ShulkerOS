#!/usr/bin/lua
-- find SHULKER_HOME (/opt/shulker, or /mnt/builtin/shulker from the data pack) and its libraries
local H = os.getenv("SHULKER_HOME")
if not H or H == "" then
  local p = arg and arg[0] or ""
  local d = p:match("^(.*)/bin/[^/]+$") or (p:match("^bin/[^/]+$") and ".")
  for _, c in ipairs({ d or "", (d or "") .. "/shulker", "/opt/shulker", "/mnt/builtin/shulker" }) do
    local f = c ~= "" and io.open(c .. "/lib/shulker/util.lua")
    if f then f:close() H = c break end
  end
end
H = H or "/opt/shulker"
package.path = H .. "/lib/?.lua;" .. package.path
require("shulker.util").setHome(H)

-- shulker: Shulker OS updates, apps and system checks
local U = require("shulker.util")
local pkg = require("shulker.pkg")
local c = U.c

local USAGE = [==[
usage: shulker version                 version, where it's installed, repository
       shulker update [--check] [--branch NAME]   update Shulker OS (and installed apps)
       shulker list                    apps in the repository (* = installed)
       shulker search WORD             search apps
       shulker install APP...          install apps (to /usr/local/shulker)
       shulker remove APP...           remove apps
       shulker doctor                  check disk, services, network and Claude
       shulker linux [status]          kernel, RAID support and drives
       shulker linux kernel            upgrade to the Shulker Linux kernel (/boot/Image)
       shulker linux install [DEV]     write Shulker Linux to an empty drive (then swap drives)
       shulker disks [setup --raid0|--linear|--raid1|--separate]   extra drives as /data
       shulker setup                   run the setup wizard again
       shulker enable|disable claude   turn the Claude assistant on or off
       shulker uninstall [--purge]     remove Shulker OS from this disk (--purge: also ~/.shulker)
see `man shulker`]==]

local function progress(i, n, path)
  if U.isatty(1) then io.write(("\r%s %d/%d %s\27[K"):format(c("accent", "downloading"), i, n, path)) io.flush() end
end
local function done() if U.isatty(1) then io.write("\r\27[K") end end

local a = arg
local cmd = a[1]
if not cmd or cmd == "-h" or cmd == "--help" or cmd == "help" then print(USAGE) os.exit(cmd and 0 or 1) end

if cmd == "setup" then
  os.execute(U.q(U.home() .. "/bin/shulker-setup"))
  os.exit(0)
elseif cmd == "enable" or cmd == "disable" then
  if a[2] ~= "claude" then U.die("usage: shulker enable|disable claude") end
  local path = U.etcdir() .. "/setup.conf"
  local lines, found = U.lines(path), false
  for i, l in ipairs(lines) do if l:match("^claude=") then lines[i] = "claude=" .. (cmd == "enable" and "on" or "off") found = true end end
  if not found then lines[#lines + 1] = "claude=" .. (cmd == "enable" and "on" or "off") end
  U.mkdir(U.etcdir())
  U.write(path, table.concat(lines, "\n") .. "\n")
  print("Claude assistant " .. (cmd == "enable" and "on" or "off") .. ".")
  os.exit(0)
elseif cmd == "linux" or cmd == "disks" then
  local L = require("shulker.linux")
  local function log(s) print(c("accent", "::") .. " " .. s) end
  local function confirm(q)
    if a[#a] == "--yes" or a[#a] == "-y" then return true end
    local ans = require("shulker.chat").ttyRead(q .. " [y/N] ")
    return ans and ans:lower():match("^y")
  end
  local function showDrives()
    for _, d in ipairs(L.drives()) do
      local what = d.root and "system (boot)" or d.md and ("in " .. d.md) or d.mount and ("mounted at " .. d.mount) or "free"
      print(("  %-9s %7.1f MB  %s"):format(d.dev, d.kb / 1024, what))
    end
  end
  local sub = a[2] or "status"
  if cmd == "linux" and sub == "status" then
    print(c("bright", L.osName()) .. "  kernel " .. U.trim(U.capture("uname -r")))
    print("RAID support: " .. (L.hasMD() and c("ok", "yes") or c("warn", "no (stock Sedna kernel)")))
    print("image source: " .. L.base())
    showDrives()
  elseif cmd == "linux" and sub == "kernel" then
    local ok, msg = L.upgradeKernel(log)
    if not ok then U.die("shulker: " .. msg) end
    print(msg)
  elseif cmd == "linux" and sub == "install" then
    local dev = a[3] and not a[3]:match("^%-") and a[3]
    if not dev then
      local spare = L.spare()
      if #spare == 0 then U.die("shulker: no free drive. Put an empty hard drive (16 MB or more) in the computer.") end
      dev = spare[1].dev
    end
    print(("This erases %s and writes Shulker Linux to it. Your /root, /etc/shulker, passwords,"):format(dev))
    print("hostname and network settings are copied over.")
    if not confirm("Erase " .. dev .. "?") then os.exit(1) end
    local ok, err = L.installTo(dev, log)
    if not ok then U.die("shulker: " .. err) end
    print(c("ok", "Shulker Linux is on " .. dev .. "."))
    print("Shut down, then swap the two drives so that one is first, and start the computer.")
    print("Keep the old drive as a backup until everything works.")
  elseif cmd == "disks" and (sub == "status" or sub == "list") then
    showDrives()
    local conf = L.disksConf()
    if conf.mode then print(("data: %s over %s, at /data"):format(conf.mode, conf.devices)) end
    if U.exists("/proc/mdstat") then io.write(U.read("/proc/mdstat") or "") end
  elseif cmd == "disks" and sub == "mount" then
    local ok, err = L.mountDisks()
    if not ok then U.die("shulker: " .. err) end
  elseif cmd == "disks" and sub == "setup" then
    local mode = L.hasMD() and "raid0" or "separate"
    for _, x in ipairs(a) do
      local m = x:match("^%-%-(%a+%d?)$")
      if m == "raid0" or m == "linear" or m == "raid1" or m == "separate" then mode = m end
    end
    local cur = L.disksConf()
    if cur.mode then
      print(("/data is now: %s over %s"):format(cur.mode, cur.devices or "?"))
      if not confirm("Set it up again? This erases everything in /data.") then os.exit(1) end
      local ok, err = L.releaseDisks()
      if not ok then U.die("shulker: " .. err) end
    end
    if mode == "separate" and not L.hasMD() then
      print(c("warn", "This kernel has no RAID,") .. " so each drive becomes its own /data/N.")
      print("For one big /data: shulker linux kernel, reboot, shulker install mdadm, then shulker disks setup.")
    end
    local spare = L.spare()
    if #spare == 0 then U.die("shulker: no free drives (the system drive is never used for /data)") end
    showDrives()
    local names = {}
    for _, d in ipairs(spare) do names[#names + 1] = d.dev end
    if not confirm(("Erase %s and use them as /data (%s)?"):format(table.concat(names, " "), mode)) then os.exit(1) end
    local ok, err = L.setupDisks(mode, spare, log)
    if not ok then U.die("shulker: " .. err) end
    print(c("ok", "Done.") .. " " .. U.trim(U.capture("df -h /data 2>/dev/null | tail -1")))
  else
    U.die("usage: shulker linux [status|kernel|install [DEV]]  |  shulker disks [status|setup [--raid0|--linear|--raid1|--separate]|mount]")
  end
  os.exit(0)
end

if cmd == "version" or cmd == "-v" or cmd == "--version" then
  local conf = pkg.conf()
  print(("Shulker OS %s"):format(U.trim(U.read(U.home() .. "/VERSION") or U.VERSION)))
  print(c("dim", ("home %s (%s), repository %s branch %s"):format(U.home(),
    U.home():find("^/mnt/builtin") and "data pack, read-only" or "disk", conf.repo, conf.branch)))
elseif cmd == "update" or cmd == "upgrade" then
  local opts = { progress = progress }
  local i = 2
  while i <= #a do
    if a[i] == "--check" then opts.check = true
    elseif a[i] == "--branch" then opts.branch = a[i + 1] i = i + 1
    else U.die("shulker: unknown option " .. a[i]) end
    i = i + 1
  end
  print(c("dim", "checking " .. pkg.base(opts.branch) .. " ..."))
  local info, err = pkg.update(opts)
  done()
  if not info then U.die("shulker: " .. err) end
  if info.changed == 0 then
    print(c("ok", ("Shulker OS %s is up to date."):format(info.current)))
  elseif opts.check then
    print(c("warn", ("Update available: %s -> %s (%d file%s). Run: shulker update"):format(info.current, info.latest, info.changed, info.changed == 1 and "" or "s")))
  else
    print(c("ok", ("Updated Shulker OS %s -> %s (%d file%s)."):format(info.current, info.latest, info.changed, info.changed == 1 and "" or "s")))
    print(c("dim", "Open a new shell (or log in again) to pick up profile changes."))
  end
  if not opts.check then
    for _, name in ipairs(pkg.installed()) do
      local ver, perr = pkg.installPkg(name, progress)
      done()
      print(ver and (c("ok", "updated ") .. name .. " " .. ver) or c("err", name .. ": " .. tostring(perr)))
    end
  end
elseif cmd == "list" or cmd == "search" then
  local idx, err = pkg.index()
  if not idx then U.die("shulker: " .. err) end
  local inst = pkg.installed()
  local word = cmd == "search" and (a[2] or ""):lower() or nil
  for _, p in ipairs(idx) do
    if not word or p.name:find(word, 1, true) or p.description:lower():find(word, 1, true) then
      print(("%s %s %s %s"):format(inst[p.name] and c("ok", "*") or " ", c("soft", ("%-12s"):format(p.name)),
        c("dim", ("%-6s"):format(p.version)), p.description))
    end
  end
elseif cmd == "install" or cmd == "add" then
  if not a[2] then U.die("usage: shulker install APP...") end
  for i = 2, #a do
    local ver, err = pkg.installPkg(a[i], progress)
    done()
    if not ver then U.die("shulker: " .. err) end
    print(c("ok", "installed ") .. a[i] .. " " .. ver .. c("dim", "  (man " .. a[i] .. ")"))
  end
elseif cmd == "remove" or cmd == "rm" then
  if not a[2] then U.die("usage: shulker remove APP...") end
  for i = 2, #a do
    local ok, err = pkg.removePkg(a[i])
    if not ok then U.die("shulker: " .. err) end
    print("removed " .. a[i])
  end
elseif cmd == "doctor" then
  local function line(ok, text) print((ok == true and c("ok", " ok ") or ok == false and c("err", "FAIL") or c("warn", "warn")) .. "  " .. text) end
  local free = pkg.freeKB("/")
  local diskOk = false
  if free and free > 256 then diskOk = true elseif free and free > 64 then diskOk = nil end
  line(diskOk, ("disk /: %s KB free"):format(tostring(free)))
  local mem = U.capture("awk '/MemAvailable/ {print $2}' /proc/meminfo")
  line(tonumber(mem) and tonumber(mem) > 8192 or nil, ("memory: %s KB available"):format(U.trim(mem)))
  line(U.exists("/etc/profile.d/shulker.sh"), "login profile /etc/profile.d/shulker.sh")
  line(require("shulker.jobs").crondRunning(), "crond (scheduled jobs)")
  line(U.isdir("/mnt/builtin/bin"), "OC2 built-in files at /mnt/builtin")
  local ok, devices = pcall(require, "shulker.devices")
  local list, derr = ok and devices.list()
  line(list ~= nil and list ~= false or nil, list and (#list .. " device(s) on the OC2 bus") or ("device bus: " .. tostring(derr)))
  print(c("accent", "network:"))
  os.execute(U.q(U.home() .. "/bin/netcfg") .. " test")
  print(c("accent", "claude:"))
  os.execute(U.q(U.home() .. "/bin/claude") .. " doctor")
elseif cmd == "uninstall" then
  local ok, why = pkg.writable()
  if not ok then U.die("shulker: " .. why) end
  local chat = require("shulker.chat")
  local ans = chat.ttyRead("Remove Shulker OS from " .. U.home() .. "? [y/N] ")
  if not ans or not ans:lower():match("^y") then os.exit(1) end
  os.execute("killall crond 2>/dev/null")
  os.execute("rm -f /etc/profile.d/shulker.sh /etc/init.d/S95shulker")
  os.execute("printf '\\nWelcome to Sedna\\n' > /etc/issue; rm -f /etc/motd")
  for _, name in ipairs(pkg.installed()) do pkg.removePkg(name) end
  os.execute("rm -rf " .. U.q(U.home()) .. " /etc/shulker")
  if a[2] == "--purge" then os.execute("rm -rf " .. U.q(U.userdir())) end
  print("Shulker OS removed." .. (a[2] == "--purge" and "" or " Your tasks, jobs and key are still in " .. U.userdir() .. "."))
else
  U.die("shulker: unknown command " .. cmd .. "\n" .. USAGE)
end
