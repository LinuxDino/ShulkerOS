#!/usr/bin/lua
-- find SHULKER_HOME (/opt/shulker, or /mnt/builtin/shulker from the data pack) and its libraries
local H = os.getenv("SHULKER_HOME")
if not H or H == "" then
  local p = arg and arg[0] or ""
  local d = p:match("^(.*)/bin/[^/]+$") or (p:match("^bin/[^/]+$") and ".")
  for _, c in ipairs({ d or "", (d or "") .. "/shulker", "/opt/shulker", "/mnt/builtin/shulker" }) do
    local f = c ~= "" and io.open(c .. "/lib/shulker/util.lua")
    if f then f:close() H = c break end
  end
end
H = H or "/opt/shulker"
package.path = H .. "/lib/?.lua;" .. package.path
require("shulker.util").setHome(H)

-- swarm: many OC2 computers working as one (see `man swarm`)
local U = require("shulker.util")
local json = require("shulker.json")
local S = require("shulker.swarm")
local c = U.c

local USAGE = [==[
usage: swarm init [--work]          make this computer the main node (--work: it runs jobs too)
       swarm join [MAIN-IP]         make this computer a worker (default main 10.42.0.1)
       swarm status                 nodes, load, memory, disk, jobs
       swarm top                    live topology: gateway, main, nodes, drones, traffic
       swarm base [off]             make this worker a drone base (network tunnel cards)
       swarm drones                 every drone: base, energy, position, modules
       swarm drone NAME COMMAND     e.g. swarm drone drone1 go 10 0 -5 (see `man drone`)
       swarm run [--on NODE] CMD    run CMD on every node (or one) and show the output
       swarm submit [--on NODE] CMD queue CMD for any free node (or one), print the job number
       swarm map 'CMD {}' ITEM...   one job per ITEM ({} = the item) spread over the nodes
       swarm jobs | result ID | wait ID... | cancel ID|--all
       swarm order COMMAND          split work over the swarm: mine X1 Y1 Z1 X2 Y2 Z2, home [all],
                                    go DRONE X Y Z, run [on NAME|all] CMD, map 'CMD {}' ITEM...
       swarm orders [ID]            orders with progress (ID: every piece and its output)
       swarm find WORD              which computer's inventories hold an item (any mod)
       swarm devices                what is on every computer's bus (machines, storage, tanks)
       swarm stop ID                stop an order, running pieces too
       control                      the Control Center: all of this on one screen
       swarm enroll [MINUTES]       accept new nodes for a while (default 30)
       swarm forget NODE            remove a node     swarm bench   measure the speed-up
       swarm log                    what the service did     swarm leave   stop being part of it]==]

local a = arg
local cmd = a[1]
if not cmd or cmd == "-h" or cmd == "--help" or cmd == "help" then print(USAGE) os.exit(cmd and 0 or 1) end

local function call(msg, timeout)
  local conf = S.loadConf()
  if not conf.role then U.die("swarm: this computer is not in a swarm. Run `swarm init` (main) or `swarm join` (worker).") end
  if conf.role == "main" then conf.leader = "127.0.0.1" end
  local reply, err = S.call(conf, msg, timeout)
  if not reply then U.die("swarm: " .. err) end
  return reply
end

local function needRoot()
  if U.trim((U.capture("id -u"))) ~= "0" then U.die("swarm: run this as root") end
end

-- wait for jobs to end; returns the job list
local function waitJobs(ids, quiet)
  local t0 = os.time()
  local spin = { "|", "/", "-", "\\" }
  local i = 0
  while true do
    local r = call({ op = "jobs", ids = json.array(ids), full = true })
    local open = 0
    for _, j in ipairs(r.jobs) do if j.state == "queued" or j.state == "running" then open = open + 1 end end
    if open == 0 then
      if not quiet and U.isatty(2) then io.stderr:write("\r\27[K") end
      return r.jobs, os.time() - t0
    end
    if not quiet and U.isatty(2) then
      i = i + 1
      io.stderr:write(("\r%s %d of %d jobs left, %ds"):format(spin[i % 4 + 1], open, #ids, os.time() - t0))
    end
    os.execute("sleep 1")
  end
end

local function showJob(j, header)
  local mark = j.state == "done" and c("ok", "ok") or c("err", j.state)
  if header then print(c("accent", ("== %s"):format(j.node or "?")) .. "  " .. mark .. c("dim", (" job %d, exit %s"):format(j.id, S.exitText and S.exitText(j.rc) or tostring(j.rc)))) end
  local out = tostring(j.out or "")
  if out ~= "" then io.write(out, out:sub(-1) == "\n" and "" or "\n") end
end

local function bar(free, total, width)
  free, total = tonumber(free) or 0, tonumber(total) or 0
  if total <= 0 then return string.rep(" ", width) end
  local used = math.floor((total - free) / total * width + 0.5)
  return c("accent", string.rep("#", used)) .. c("dim", string.rep(".", width - used))
end

---------------------------------------------------------------- setup
if cmd == "init" then
  needRoot()
  local conf = S.loadConf()
  conf.role = "main"
  conf.token = conf.token or S.newToken()
  conf.leader = S.LEADER_IP
  conf.rename = "no"
  conf.work = (a[2] == "--work") and "1" or (conf.work or "0")
  S.saveConf(conf)
  U.write(U.etcdir() .. "/swarm-dnsmasq.conf", S.dnsmasqConf())
  print(c("accent", ":: ") .. "network: " .. S.LEADER_IP .. "/24, gateway " .. S.GATEWAY_IP .. ", DHCP for the workers")
  os.execute(U.q(U.home() .. "/bin/netcfg") .. " static " .. S.LEADER_IP .. "/24 " .. S.GATEWAY_IP .. " 1.1.1.1 >/dev/null")
  S.stopServices()
  S.startServices(conf)
  os.execute("sleep 2")
  call({ op = "enroll", seconds = 1800 })
  print(c("ok", "This computer is the main node of the swarm."))
  print("Now power on the workers. On a plain Sedna computer type this one line (no internet needed):")
  print("  " .. c("soft", "udhcpc -i eth0 && wget -qO- http://" .. S.LEADER_IP .. "/join | sh"))
  print("Computers with the \"Shulker Swarm Node\" drive join by themselves, ones that already run")
  print("Shulker OS with `swarm join`. New nodes are accepted for 30 minutes (`swarm enroll` opens the")
  print("window again). Watch them arrive: " .. c("soft", "swarm top"))
  os.exit(0)
elseif cmd == "join" then
  needRoot()
  local conf = S.loadConf()
  conf.role = "worker"
  conf.leader = a[2] or conf.leader or S.LEADER_IP
  conf.name, conf.token = nil, nil
  S.saveConf(conf)
  if not S.ip() then
    print(c("accent", ":: ") .. "getting an address from the main node (DHCP)")
    os.execute(U.q(U.home() .. "/bin/netcfg") .. " dhcp >/dev/null")
  end
  S.stopServices()
  S.startServices(conf)
  print(c("ok", "Joining the swarm at " .. conf.leader .. ".") .. " Check with `swarm status` in a few seconds.")
  print(c("dim", "(The main node must be accepting nodes: `swarm enroll` there.)"))
  os.exit(0)
elseif cmd == "base" then
  -- a drone base: this worker relays for drones linked by network tunnel cards
  needRoot()
  local conf = S.loadConf()
  if conf.role ~= "worker" then U.die("swarm: join the swarm first (`swarm join`), then make this computer a drone base") end
  conf.base = (a[2] == "off") and "0" or "1"
  S.saveConf(conf)
  S.stopServices()
  S.startServices(conf)
  if conf.base == "0" then print("This computer is no longer a drone base.") os.exit(0) end
  local links, uplink = S.links()
  if not uplink then
    print(c("err", "No connection to the main computer found.") .. " This base needs a network interface card")
    print("cabled to the swarm network (the main hands it a 10.42.0.x address). Check the cable, then `swarm base` again.")
  elseif #links == 0 then
    print(c("warn", "No tunnel link found.") .. " Put a network tunnel card in this computer (shut it down first),")
    print("link it to the tunnel module of the drone (use the card, insert the module), then run `swarm base` again.")
  else
    print(("Uplink to the main: %s (%s)"):format(uplink, tostring(S.addrOf(uplink))))
    print(c("ok", "Drone base ready.") .. " Links: ")
    for _, l in ipairs(links) do print(("  %s  %s.0/24, drones get %s.10-60"):format(l.iface, l.net, l.net)) end
    print("On a drone without the Shulker Drone drive, type:")
    print("  " .. c("soft", "udhcpc -i eth0 && wget -qO- http://" .. links[1].ip .. "/join | sh") .. "   (use the link's address)")
  end
  os.exit(0)
elseif cmd == "leave" then
  needRoot()
  S.stopServices()
  os.remove(S.confPath())
  print("This computer left the swarm (its network setup is unchanged).")
  os.exit(0)
elseif cmd == "services" then           -- used by the boot script
  S.startServices()
  os.exit(0)
elseif cmd == "log" then
  for _, f in ipairs({ "/tmp/swarmd-leader.log", "/tmp/swarmd-worker.log" }) do
    if U.exists(f) then print(c("accent", "== " .. f)) os.execute("tail -n 20 " .. f) end
  end
  os.exit(0)
end

---------------------------------------------------------------- talking to the main node
if cmd == "status" or cmd == "st" then
  local r = call({ op = "status" })
  local on = 0
  print(c("dim", ("%-8s %-14s %-6s %-5s %-14s %-14s %s"):format("NODE", "ADDRESS", "STATE", "LOAD", "MEMORY", "DISK", "UP")))
  for _, n in ipairs(r.nodes) do
    local st = n.stats or {}
    local state = not n.online and c("err", "off  ") or n.busy and c("warn", "busy ") or c("ok", "idle ")
    if n.online then on = on + 1 end
    print(("%-8s %-14s %s %-5s %s %s %s"):format(c("soft", ("%-8s"):format(n.name)), n.ip or "?", state,
      st.load and ("%.2f"):format(st.load) or "-", bar(st.mem_free, st.mem_total, 6) .. " " .. U.human((st.mem_total or 0) * 1024):sub(1, 6),
      bar(st.disk_free, st.disk_total, 6) .. " " .. U.human((st.disk_free or 0) * 1024) .. " free",
      n.online and S.age(st.uptime) or c("dim", "seen " .. S.age(n.seen) .. " ago")))
  end
  print(c("dim", ("%d node%s, %d online, %d job%s running, %d queued%s"):format(#r.nodes, #r.nodes == 1 and "" or "s", on,
    r.running, r.running == 1 and "" or "s", r.queued,
    r.enrolling > 0 and (", accepting new nodes for " .. S.age(r.enrolling)) or "")))
  if #r.nodes == 0 then print("No nodes yet. Power on the workers, or `swarm join` on them; `swarm enroll` if the window closed.") end
elseif cmd == "top" or cmd == "topology" then
  -- live topology: internet, gateway, main node, workers (drones later under their base), traffic
  local T = require("shulker.tui")
  local function rate(bps)
    bps = tonumber(bps)
    if not bps then return "   -  " end
    if bps >= 1048576 then return ("%5.1fM"):format(bps / 1048576) end
    if bps >= 1024 then return ("%5.1fK"):format(bps / 1024) end
    return ("%5dB"):format(math.floor(bps))
  end
  local once = a[2] == "--once"
  if not once then T.start() end
  local scroll = 0
  local ok, err = pcall(function()
    while true do
      local r = call({ op = "status" })
      T.clear()
      local online, rxSum, txSum = 0, 0, 0
      for _, n in ipairs(r.nodes) do
        if n.online then online = online + 1 rxSum = rxSum + (n.rx_rate or 0) txSum = txSum + (n.tx_rate or 0) end
      end
      T.at(1, 1, string.rep(" ", T.W), "bright", "purple")
      T.at(2, 1, "Shulker Swarm topology", "bright", "purple")
      local right = ("%d/%d online  %s"):format(online, #r.nodes, os.date("%H:%M:%S"))
      T.at(T.W - #right, 1, right, "lavender", "purple")
      -- internet and gateway
      local gwUp = r.gateway == "reachable"
      T.at(3, 3, "( Internet )", gwUp and "aqua" or "gray")
      T.g(16, 3, "qq", gwUp and "aqua" or "gray")
      T.at(19, 3, "Internet Gateway " .. S.GATEWAY_IP, gwUp and "bright" or "gray")
      T.at(48, 3, gwUp and "reachable" or (r.gateway == "unknown" and "checking..." or "not found"), gwUp and "lime" or "gold")
      T.g(9, 4, "x", "purple")
      -- the main node, then the hub with the workers
      local main
      for _, n in ipairs(r.nodes) do if n.main then main = n end end
      local mainName = main and main.name or (r.leader.host ~= "" and r.leader.host or "main")
      T.g(9, 5, "t", "purple")
      T.at(11, 5, ("%-8s"):format(mainName), "bright")
      T.at(20, 5, "MAIN", "bright", "purple")
      T.at(26, 5, ("%-15s"):format(r.leader.ip or S.LEADER_IP), "white")
      if main then T.at(42, 5, "rx " .. rate(main.rx_rate) .. "/s  tx " .. rate(main.tx_rate) .. "/s", "lavender") end
      T.g(9, 6, "x", "purple")
      T.g(9, 7, "mqqk", "purple")
      T.at(14, 7, "hub", "gray")
      local y = 8
      local workers, dronesOf = {}, {}
      for _, n in ipairs(r.nodes) do
        if n.stats and n.stats.drone and n.via then
          dronesOf[n.via] = dronesOf[n.via] or {}
          table.insert(dronesOf[n.via], n)
        elseif not n.main then
          workers[#workers + 1] = n
        end
      end
      -- put each base's drones right after it in the list
      local rows = {}
      for _, n in ipairs(workers) do
        rows[#rows + 1] = n
        local host = n.stats and n.stats.host
        for _, d in ipairs(dronesOf[n.name] or dronesOf[host or ""] or {}) do d.isDrone = true rows[#rows + 1] = d end
      end
      workers = rows
      local room = T.H - 12
      local first = math.min(scroll, math.max(0, #workers - room))
      for i = first + 1, math.min(#workers, first + room) do
        local n = workers[i]
        local last = i == #workers
        if n.isDrone then
          T.g(12, y, last and " " or "x", "purple")
          T.g(16, y, "mq", "aqua")
          local d = n.stats.drone
          T.at(19, y, ("%-7s"):format(n.name), n.online and "aqua" or "gray")
          T.at(27, y, d.charge and ("energy %3d%%"):format(d.charge) or "energy ?", (d.charge or 100) < 15 and "pink" or "white")
          T.at(40, y, d.pos and ("at %d %d %d"):format(d.pos.x, d.pos.y, d.pos.z) or "", "gray")
          T.at(56, y, not n.online and "off" or n.busy and ("job " .. n.busy) or "idle", not n.online and "pink" or n.busy and "gold" or "lime")
          y = y + 1
          goto continue
        end
        T.g(12, y, last and "mqq" or "tqq", "purple")
        local st = n.stats or {}
        local state, fg = "idle", "lime"
        if not n.online then state, fg = "off", "pink" elseif n.busy then state, fg = "job " .. n.busy, "gold" end
        T.at(16, y, ("%-8s"):format(n.name), n.online and "bright" or "gray")
        T.at(25, y, ("%-15s"):format(n.ip or "?"), n.online and "white" or "gray")
        T.at(41, y, ("%-8s"):format(state), fg)
        if n.online then
          T.at(50, y, "rx " .. rate(n.rx_rate) .. " tx " .. rate(n.tx_rate), "lavender")
          T.at(71, y, ("ld %.1f"):format(st.load or 0), "gray")
          if (tonumber(st.alerts) or 0) > 0 then T.at(79, y, ("! %d alert%s"):format(st.alerts, st.alerts == 1 and "" or "s"), "pink")
          elseif st.energy then T.at(79, y, ("E %d%%"):format(st.energy), st.energy < 20 and "pink" or "gray") end
        else
          T.at(50, y, "last seen " .. S.age(n.seen) .. " ago", "gray")
        end
        y = y + 1
        ::continue::
      end
      if #workers > room then T.at(16, y, ("(%d more: Up/Down to scroll)"):format(#workers - room), "gray") y = y + 1 end
      if #workers == 0 then T.at(16, y, "no workers yet: power them on (Swarm Node drive) or `swarm join`", "gray") end
      -- totals and recent events
      local by = T.H - 3
      T.hline(1, by, T.W, "purple")
      T.at(2, by + 1, ("jobs: %d running, %d queued    swarm traffic: rx %s/s  tx %s/s%s"):format(r.running, r.queued,
        U.trim(rate(rxSum)), U.trim(rate(txSum)), r.enrolling > 0 and ("    accepting nodes " .. S.age(r.enrolling)) or ""), "white")
      T.at(2, by + 2, r.log[1] and ("last event: " .. r.log[1]) or "", "gray")
      T.at(T.W - 18, T.H, "q quit  e enroll", "gray")
      T.flush()
      if once then return end
      local ev = T.event(2000)
      if ev.type == "key" then
        if ev.key == "q" or ev.key == "esc" or ev.key == "ctrl-c" then return end
        if ev.key == "down" then scroll = scroll + 1 elseif ev.key == "up" then scroll = math.max(0, scroll - 1) end
        if ev.key == "e" then call({ op = "enroll", seconds = 1800 }) end
      end
    end
  end)
  if not once then T.stop() end
  if not ok and not tostring(err):find("interrupted") then U.die("swarm: " .. tostring(err)) end
elseif cmd == "drones" then
  local r = call({ op = "status" })
  local n = 0
  print(c("dim", ("%-8s %-10s %-6s %-8s %-14s %-8s %s"):format("DRONE", "BASE", "STATE", "ENERGY", "POSITION", "FACING", "MODULES")))
  for _, x in ipairs(r.nodes) do
    local d = x.stats and x.stats.drone
    if d then
      n = n + 1
      local pos = d.pos and ("%d %d %d"):format(d.pos.x, d.pos.y, d.pos.z) or "?"
      local state = not x.online and c("err", "off   ") or x.busy and c("warn", "busy  ") or c("ok", "idle  ")
      local charge = d.charge and ((d.charge < 15 and c("err", "%3d%%") or "%3d%%"):format(d.charge)) or "  ?"
      print(("%-8s %-10s %s %-8s %-14s %-8s %s"):format(c("soft", ("%-8s"):format(x.name)), x.via or "-", state, charge,
        pos, tostring(d.facing or "?"), table.concat(d.modules or {}, ",")))
    end
  end
  if n == 0 then print("No drones yet. See `man drone`: a robot with the Shulker Drone drive, linked to a drone base.") end
elseif cmd == "drone" then
  local name = a[2]
  if not name or not a[3] then U.die("usage: swarm drone NAME COMMAND...   e.g. swarm drone drone1 go 10 0 -5") end
  local command = "drone " .. table.concat(a, " ", 3)
  local r = call({ op = "submit", cmd = command, target = name, timeout = 1800 })
  local jobs = waitJobs(r.ids)
  for _, j in ipairs(jobs) do showJob(j, false) end
  os.exit(jobs[1] and jobs[1].state == "done" and 0 or 1)
elseif cmd == "run" then
  local target, i = "all", 2
  if a[2] == "--on" then target, i = a[3], 4 end
  local command = table.concat(a, " ", i)
  if command == "" then U.die("usage: swarm run [--on NODE] COMMAND") end
  local r = call({ op = "submit", cmd = command, target = target })
  local jobs = waitJobs(r.ids)
  table.sort(jobs, function(x, y) return (x.node or "") < (y.node or "") end)
  local bad = 0
  for _, j in ipairs(jobs) do showJob(j, true) if j.state ~= "done" then bad = bad + 1 end end
  os.exit(bad == 0 and 0 or 1)
elseif cmd == "submit" then
  local target, i = "any", 2
  if a[2] == "--on" then target, i = a[3], 4 end
  local command = table.concat(a, " ", i)
  if command == "" then U.die("usage: swarm submit [--on NODE] COMMAND") end
  local r = call({ op = "submit", cmd = command, target = target })
  print(r.ids[1])
elseif cmd == "map" then
  local template = a[2]
  local items = {}
  for i = 3, #a do items[#items + 1] = a[i] end
  if #items == 0 and not U.isatty(0) then for line in io.lines() do if line:match("%S") then items[#items + 1] = line end end end
  if not template or #items == 0 then U.die("usage: swarm map 'COMMAND {}' ITEM...   (or items on stdin, one per line)") end
  if not template:find("{}", 1, true) then template = template .. " {}" end
  local r = call({ op = "submit", cmd = template, map = json.array(items) })
  local jobs, secs = waitJobs(r.ids)
  table.sort(jobs, function(x, y) return x.id < y.id end)
  local bad = 0
  for k, j in ipairs(jobs) do
    if j.state ~= "done" then bad = bad + 1 io.stderr:write(c("err", ("%s: %s on %s (exit %s)\n"):format(items[k], j.state, j.node or "?", S.exitText(j.rc)))) end
    showJob(j, false)
  end
  io.stderr:write(c("dim", ("%d job%s in %ds\n"):format(#jobs, #jobs == 1 and "" or "s", secs)))
  os.exit(bad == 0 and 0 or 1)
elseif cmd == "jobs" then
  local r = call({ op = "jobs" })
  if #r.jobs == 0 then print(c("dim", "no jobs")) end
  for _, j in ipairs(r.jobs) do
    local st = j.state == "done" and c("ok", "done   ") or (j.state == "running" and c("warn", "running") or
      j.state == "queued" and c("dim", "queued ") or c("err", ("%-7s"):format(j.state)))
    print(("%4d %s %-7s %s"):format(j.id, st, j.node or "-", j.cmd:gsub("\n", " "):sub(1, 50)))
  end
elseif cmd == "result" or cmd == "wait" then
  local ids = {}
  for i = 2, #a do ids[#ids + 1] = tonumber(a[i]) end
  if #ids == 0 then U.die("usage: swarm " .. cmd .. " ID...") end
  local jobs = cmd == "wait" and waitJobs(ids) or call({ op = "jobs", ids = json.array(ids), full = true }).jobs
  for _, j in ipairs(jobs) do showJob(j, #jobs > 1 or cmd == "result") end
elseif cmd == "order" then
  local O = require("shulker.orders")
  local line = table.concat(a, " ", 2)
  -- keep the user's quoting: arg[] lost it, so quote words that need it again
  local parts = {}
  for i = 2, #a do parts[#parts + 1] = a[i]:match("[%s'\"]") and U.q(a[i]) or a[i] end
  line = table.concat(parts, " ")
  local status = call({ op = "status" })
  local o, err = O.parse(line, status)
  if not o then U.die("swarm: " .. err) end
  local r = call({ op = "order", label = o.label, kind = o.kind, pieces = o.pieces })
  print(("order %d: %s, %d piece%s%s"):format(r.id, o.label, #o.pieces, #o.pieces == 1 and "" or "s",
    o.note and (" (" .. o.note .. ")") or ""))
  print("follow it with `swarm orders " .. r.id .. "` or in `control`")
elseif cmd == "devices" then
  local st = call({ op = "status" })
  for _, n in ipairs(st.nodes) do
    local d = n.stats and n.stats.devices
    local parts = {}
    if type(d) == "table" then
      local names = {}
      for k in pairs(d) do names[#names + 1] = k end
      table.sort(names)
      for _, k in ipairs(names) do parts[#parts + 1] = (d[k] > 1 and (d[k] .. "x ") or "") .. k end
    end
    print(("%-9s %s"):format(n.name, #parts > 0 and table.concat(parts, ", ") or
      c("dim", n.online and "nothing reported (bus daemon not running, or old Shulker OS)" or "offline")))
  end
elseif cmd == "find" then
  local word = table.concat(a, " ", 2)
  if word == "" then U.die("usage: swarm find WORD   (e.g. swarm find diamond)") end
  local ST = require("shulker.storage")
  if U.isatty(2) then io.stderr:write("asking every computer...\r") end
  local r, err = ST.swarmFind(call, word)
  if U.isatty(2) then io.stderr:write("\27[K") end
  if not r then U.die("swarm: " .. err) end
  if #r.list == 0 then print(("no %s on %d computer%s"):format(word, r.answered, r.answered == 1 and "" or "s")) end
  for _, f in ipairs(r.list) do
    local where = {}
    for _, w in ipairs(f.where) do where[#where + 1] = w.host .. " " .. w.count end
    print(("%8d  %-28s %s"):format(f.count, ST.short(f.item):sub(1, 28), c("dim", table.concat(where, ", "))))
  end
  if r.answered < r.asked then
    print(c("warn", ("%d of %d computers did not answer (old Shulker OS or busy)"):format(r.asked - r.answered, r.asked)))
  end
elseif cmd == "orders" then
  local r = call({ op = "orders", id = tonumber(a[2] or "") })
  if #r.orders == 0 then print("no orders yet: swarm order ... or control") end
  for _, o in ipairs(r.orders) do
    local k = o.counts
    local fg = o.state == "done" and "ok" or o.state == "failed" and "err" or "accent"
    print(("%s %-4s %-44s %d/%d done%s%s"):format(c(fg, "*"), "#" .. o.id, o.label:sub(1, 44), k.done, o.total,
      k.running > 0 and (", " .. k.running .. " running") or "", (k.failed + k.lost) > 0 and c("err", (", %d failed"):format(k.failed + k.lost)) or ""))
    if a[2] then
      for _, p in ipairs(o.pieces) do
        print(("    %-8s %-14s %-9s %s"):format(p.state, p.label or "", p.node or "-", p.rc and ("exit " .. p.rc) or ""))
        if p.out and p.out ~= "" then
          local tail = p.out:gsub("%s+$", ""):match("([^\n]*)$")
          print("             " .. c("dim", tail:sub(1, 60)))
        end
      end
    end
  end
elseif cmd == "stop" then
  if not tonumber(a[2] or "") then U.die("usage: swarm stop ORDER-ID") end
  local r = call({ op = "cancel", order = tonumber(a[2]), stop = true })
  print(("order %s: %d piece(s) stopped"):format(a[2], r.cancelled))
elseif cmd == "cancel" then
  local r = call({ op = "cancel", id = tonumber(a[2] or ""), all = a[2] == "--all" })
  print(("cancelled %d queued job(s)"):format(r.cancelled))
elseif cmd == "enroll" then
  local minutes = tonumber(a[2] or "") or 30
  call({ op = "enroll", seconds = minutes * 60 })
  print(("Accepting new nodes for %d minutes."):format(minutes))
elseif cmd == "forget" then
  if not a[2] then U.die("usage: swarm forget NODE") end
  call({ op = "forget", name = a[2] })
  print("removed " .. a[2])
elseif cmd == "bench" then
  -- the same CPU-bound work, first on one node, then one piece per online node at once
  local st = call({ op = "status" })
  local n = 0
  for _, x in ipairs(st.nodes) do if x.online then n = n + 1 end end
  if n == 0 then U.die("swarm: no node is online") end
  local work = "lua -e 'local x = 0 for i = 1, 20000000 do x = x + i % 7 end'"
  print(("Benchmark: a fixed piece of Lua work, on 1 node, then on %d node%s at once."):format(n, n == 1 and "" or "s"))
  local r1 = call({ op = "submit", cmd = work, target = "any" })
  local _, t1 = waitJobs(r1.ids)
  local items = {}
  for i = 1, n do items[i] = tostring(i) end
  local rn = call({ op = "submit", cmd = work .. " # {}", map = json.array(items) })
  local _, tn = waitJobs(rn.ids)
  t1, tn = math.max(t1, 1), math.max(tn, 1)
  print(("1 piece on 1 node: %ds.  %d pieces on %d nodes: %ds.  Speed-up: %.1fx (ideal %dx)"):format(
    t1, n, n, tn, n * t1 / tn, n))
else
  U.die("swarm: unknown command " .. cmd .. "\n" .. USAGE)
end
