#!/usr/bin/lua
-- find SHULKER_HOME (/opt/shulker, or /mnt/builtin/shulker from the data pack) and its libraries
local H = os.getenv("SHULKER_HOME")
if not H or H == "" then
  local p = arg and arg[0] or ""
  local d = p:match("^(.*)/bin/[^/]+$") or (p:match("^bin/[^/]+$") and ".")
  for _, c in ipairs({ d or "", (d or "") .. "/shulker", "/opt/shulker", "/mnt/builtin/shulker" }) do
    local f = c ~= "" and io.open(c .. "/lib/shulker/util.lua")
    if f then f:close() H = c break end
  end
end
H = H or "/opt/shulker"
package.path = H .. "/lib/?.lua;" .. package.path
require("shulker.util").setHome(H)

-- swarmd: the Shulker Swarm service.  swarmd leader | swarmd worker   (started at boot by rc.shulker)
local U = require("shulker.util")
local json = require("shulker.json")
local S = require("shulker.swarm")

local mode = arg[1]
if mode ~= "leader" and mode ~= "worker" and mode ~= "relay" then
  io.stderr:write("usage: swarmd leader|worker|relay   (normally started at boot; see `man swarm`)\n")
  os.exit(2)
end
if not S.socket then io.stderr:write("swarmd: luasocket is missing\n") os.exit(1) end
local socket = S.socket

local function log(...)
  io.write(os.date("%H:%M:%S "), table.concat({ ... }, " "), "\n")
  io.flush()
end

-- after `shulker update` (pkg.refreshSystem leaves a flag) a running service restarts itself with the
-- new code, but only when it is idle: a worker between jobs, the main with no queued or running jobs
-- (its job list lives in memory)
local function restartIfUpdated(idle, sockets)
  local flag = "/tmp/swarmd-restart-" .. mode
  if not idle or not U.exists(flag) then return end
  os.remove(flag)
  log("Shulker OS was updated: restarting with the new version")
  -- close our listening ports first: the restart helper would inherit them and keep them busy
  for _, sk in ipairs(sockets or {}) do pcall(sk.close, sk) end
  os.execute(("(sleep 2; SHULKER_HOME=%s %s services) >/dev/null 2>&1 &"):format(U.q(U.home()), U.q(U.home() .. "/bin/swarm")))
  os.exit(0)
end

---------------------------------------------------------------- leader
if mode == "leader" then
  local conf = S.loadConf()
  if not conf.token then io.stderr:write("swarmd: no token in " .. S.confPath() .. " (run `swarm init`)\n") os.exit(1) end
  local L = S.newLeader(conf)
  if tonumber(conf.enroll_until or "") then L.enrollUntil = tonumber(conf.enroll_until) end
  local server, err
  for _ = 1, 30 do                              -- the address may not be up yet right after boot
    server, err = socket.bind("*", conf.port)
    if server then break end
    socket.sleep(1)
  end
  if not server then log("cannot listen on port", conf.port, err) os.exit(1) end
  server:settimeout(0)
  log("leader listening on port", conf.port)
  -- plain HTTP for the network install of workers (`wget -qO- http://10.42.0.1/join | sh`)
  local web = socket.bind("*", S.HTTP_PORT)
  if web then web:settimeout(0) log("serving the network install on port", S.HTTP_PORT)
  else log("cannot serve the network install on port", S.HTTP_PORT) end
  local lastReap, lastGw = 0, 0
  -- automatic updates: the main checks GitHub 15 minutes after it starts, then once a day
  local nextAuto = os.time() + 900
  while true do
    local ready = socket.select(web and { server, web } or { server }, nil, 1)
    if web and ready and ready[web] then
      local wc = web:accept()
      if wc then pcall(S.serveHttp, wc, S.ip() or conf.leader) end
    end
    -- every waiting request in one pass (server is non-blocking): a big swarm queues up quickly
    for _ = 1, (ready and ready[server]) and 64 or 0 do
      local c = server:accept()
      if not c then break end
      do
        c:settimeout(3)
        local line = c:receive("*l")
        local reply
        if line then
          local msg = json.decode(line)
          reply = L.handle(msg)
        else
          reply = { error = "empty request" }
        end
        local okEnc, text = pcall(json.encode, reply)
        c:send((okEnc and text or '{"error":"encode failed"}') .. "\n")
        c:close()
      end
    end
    if os.time() >= nextAuto then
      nextAuto = os.time() + 24 * 3600
      if require("shulker.pkg").autoUpdate() then
        log("automatic update: checking GitHub")
        os.execute(("(echo; date; SHULKER_HOME=%s %s update) >> /tmp/shulker-autoupdate.log 2>&1 &")
          :format(U.q(U.home()), U.q(U.home() .. "/bin/shulker")))
      end
    end
    if os.time() - lastReap >= 2 then
      L.reap()
      lastReap = os.time()
      local busy = false
      for _, j in ipairs(L.jobs) do if j.state == "queued" or j.state == "running" then busy = true break end end
      restartIfUpdated(not busy, { server, web })
    end
    -- is the Internet Gateway there? (in the background, the loop must not wait for ping)
    if os.time() - (lastGw or 0) >= 30 then
      lastGw = os.time()
      os.execute("(ping -c 1 -W 3 " .. S.GATEWAY_IP .. " >/dev/null 2>&1 && echo reachable || " ..
        "(nc -z -w 5 160.79.104.10 443 >/dev/null 2>&1 && echo reachable || echo 'not found')) > /tmp/swarm-gateway 2>/dev/null &")
    end
  end
end

---------------------------------------------------------------- relay (drone base)
-- drones talk to their base; the base passes their requests on to the main node, marked "via" itself
if mode == "relay" then
  local conf = S.loadConf()
  local upstream = S.leaderOf(conf)
  local api = socket.bind("*", conf.port)
  local web = socket.bind("*", S.HTTP_PORT)
  if not api then log("relay: cannot listen on port", conf.port) os.exit(1) end
  api:settimeout(0)
  if web then web:settimeout(0) end
  log("relay for drones, to the main node", upstream)
  local function hostname() return conf.name or U.trim(U.read("/etc/hostname") or "base") end
  while true do
    restartIfUpdated(true, { api, web })
    local ready = socket.select(web and { api, web } or { api }, nil, 5)
    if ready and ready[api] then
      local c = api:accept()
      if c then
        c:settimeout(5)
        local line = c:receive("*l")
        local msg = line and json.decode(line)
        local reply
        if type(msg) == "table" then
          msg.via = hostname()
          local up = socket.tcp()
          up:settimeout(15)
          if up:connect(upstream, conf.port) then
            up:send(json.encode(msg) .. "\n")
            reply = up:receive("*l")
          end
          up:close()
        end
        c:send((reply or '{"error":"the drone base cannot reach the main node"}') .. "\n")
        c:close()
      end
    end
    if web and ready and ready[web] then
      local c = web:accept()
      if c then
        c:settimeout(5)
        local head = {}
        repeat
          local h = c:receive("*l")
          if h then head[#head + 1] = h end
        until not h or h == ""
        local up = socket.tcp()
        up:settimeout(30)
        if up:connect(upstream, S.HTTP_PORT) then
          up:send(table.concat(head, "\r\n") .. "\r\n")
          while true do
            local data, err, partial = up:receive(8192)
            local chunk = data or partial
            if chunk and #chunk > 0 then c:send(chunk) end
            if not data then break end
          end
        end
        up:close()
        c:close()
      end
    end
    conf = S.loadConf()
    upstream = S.leaderOf(conf)
  end
end

---------------------------------------------------------------- worker
local conf = S.loadConf()
local joined = conf.name ~= nil and conf.token ~= nil
local running                                 -- { id, dir } of the job in progress
local results = {}                            -- finished, not yet reported
local backoff = S.HEARTBEAT

local function setName(name)
  if not name or name == conf.name then return end
  conf.name = name
  S.saveConf(conf)
  if conf.rename ~= "no" then
    U.write("/etc/hostname", name .. "\n")
    os.execute("hostname " .. U.q(name))
  end
  log("this node is", name)
end

-- jobs run like a login shell would: Shulker's commands and apps on the PATH (init's PATH has neither)
local JOB_ENV = ("export HOME=/root SHULKER_HOME=%s PATH=%s/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; ")
  :format(U.q(U.home()), U.q(U.home()))

local function startJob(job)
  job.id = math.tointeger(tonumber(job.id)) or job.id     -- JSON numbers can arrive as 11.0
  local dir = "/tmp/swarm-job-" .. job.id
  os.execute("rm -rf " .. U.q(dir))
  U.mkdir(dir)
  U.write(dir .. "/cmd.sh", tostring(job.cmd) .. "\n")
  local t = math.max(1, math.floor(tonumber(job.timeout) or 600))
  -- in the background, so the heartbeats go on while the job runs
  -- jobs start in /data when the node has one (more room than the system drive), else in /root
  -- the job runs in its own process group (setsid), so `swarm stop` can end it with everything it started
  os.execute((JOB_ENV .. "(if grep -q ' /data ' /proc/mounts; then cd /data; else cd /root; fi 2>/dev/null; " ..
    "setsid sh -c 'echo $$ > %s/pgid; exec timeout %d sh %s/cmd.sh' > %s/out 2>&1 < /dev/null; " ..
    "echo $? > %s/rc.tmp; mv %s/rc.tmp %s/rc) &")
    :format(dir, t, dir, dir, dir, dir, dir))
  running = { id = job.id, dir = dir }
  log("job", job.id, "started")
end

local function checkJob()
  if not running then return end
  local rc = U.read(running.dir .. "/rc")
  if not rc then return end
  local out = U.read(running.dir .. "/out") or ""
  results[#results + 1] = { id = running.id, rc = tonumber(U.trim(rc)) or 1, out = out:sub(-S.MAX_OUTPUT) }
  os.execute("rm -rf " .. U.q(running.dir))
  log("job", running.id, "finished, exit", U.trim(rc))
  running = nil
end

log("worker for", S.leaderOf(conf) .. ":" .. conf.port)
local lastDhcp = 0
local goingHome = false
local lastAutoCheck, lastAutoUpdate = 0, 0
-- the job is checked every second, but the main hears from us only when a beat is due (every
-- HEARTBEAT s at work, BEAT_IDLE s idle) or right away when a job finished: with 100+ drones a beat a
-- second would swamp the main and the hubs
local nextBeat, lastFull = 0, 0
while true do
  checkJob()
  restartIfUpdated(not running and #results == 0)
  -- no address yet (the main node was off when this one booted): keep asking for one
  if not S.ip() and os.time() - lastDhcp >= 20 then
    lastDhcp = os.time()
    if conf.base == "1" then
      -- a base that found its uplink now: give the drones their addresses and the relay
      if S.findUplink(conf) then S.startServices(conf) end
    else os.execute("udhcpc -n -q -t 3 -i eth0 >/dev/null 2>&1") end
    S.ip(true)
  end
  if not joined or #results > 0 or os.time() >= nextBeat then
  local full = not joined or os.time() - lastFull >= S.FULL_EVERY
  local stats = S.stats(full)
  -- drones: below 15 % energy, drive home to the charger (once, until charged above 50 %)
  local d = stats.drone
  if d and d.charge then
    if d.charge < 15 and not goingHome and not running then
      goingHome = true
      log("energy low (" .. d.charge .. "%), going home to the charger")
      os.execute("(" .. U.q(U.home() .. "/bin/drone") .. " home --dig > /tmp/drone-home.log 2>&1) &")
    elseif d.charge > 50 then
      goingHome = false
    end
  end
  local reply, err
  if not joined then
    reply, err = S.call(conf, { op = "join", stats = stats })
    if reply then
      joined = true
      if reply.token then conf.token = reply.token S.saveConf(conf) end
      setName(reply.name)
    end
  else
    reply, err = S.call(conf, { op = "heartbeat", stats = stats, light = not full or nil,
                                running = running and running.id or nil, results = json.array(results) })
    if reply then
      results = {}
      setName(reply.name)
      -- automatic updates: behind the main (its fingerprint differs from our manifest) and idle -> update
      if reply.os and conf.role ~= "main" and not running and os.time() - lastAutoCheck >= 60 then
        lastAutoCheck = os.time()
        local pkg = require("shulker.pkg")
        local mine = pkg.sha256(U.home() .. "/manifest.txt")
        if mine ~= reply.os and pkg.autoUpdate() and os.time() - lastAutoUpdate >= 600 then
          lastAutoUpdate = os.time()
          log("automatic update: the main has a newer Shulker OS")
          os.execute(("(echo; date; SHULKER_HOME=%s %s update) >> /tmp/shulker-autoupdate.log 2>&1 &")
            :format(U.q(U.home()), U.q(U.home() .. "/bin/shulker")))
        end
      end
      for _, id in ipairs(reply.stop or {}) do
        if running and tonumber(id) == tonumber(running.id) then
          local pg = U.trim(U.read(running.dir .. "/pgid") or "")
          if pg:match("^%d+$") then os.execute("kill -TERM -" .. pg .. " 2>/dev/null") end
          U.append(running.dir .. "/out", "\n[stopped from the main node]\n")
          log("job", running.id, "stopped")
        end
      end
      if reply.job and not running then startJob(reply.job) end
    elseif err and (err:find("join first") or err:find("wrong swarm token")) then
      joined = false
    end
  end
  if reply then
    backoff = S.HEARTBEAT
    if full then lastFull = os.time() end
    nextBeat = os.time() + (running and S.HEARTBEAT or S.BEAT_IDLE)
  else
    log(err)
    backoff = math.min(backoff * 2, 30)
    nextBeat = os.time() + backoff
  end
  end
  socket.sleep(1)
end
