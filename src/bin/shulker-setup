#!/usr/bin/lua
-- find SHULKER_HOME (/opt/shulker, or /mnt/builtin/shulker from the data pack) and its libraries
local H = os.getenv("SHULKER_HOME")
if not H or H == "" then
  local p = arg and arg[0] or ""
  local d = p:match("^(.*)/bin/[^/]+$") or (p:match("^bin/[^/]+$") and ".")
  for _, c in ipairs({ d or "", (d or "") .. "/shulker", "/opt/shulker", "/mnt/builtin/shulker" }) do
    local f = c ~= "" and io.open(c .. "/lib/shulker/util.lua")
    if f then f:close() H = c break end
  end
end
H = H or "/opt/shulker"
package.path = H .. "/lib/?.lua;" .. package.path
require("shulker.util").setHome(H)

-- shulker-setup: the first-boot setup wizard (also: `shulker setup`)
local U = require("shulker.util")
local T = require("shulker.tui")

local TOS_VERSION = "1"
local STEPS = 7
local CONF = U.etcdir() .. "/setup.conf"

local TOS = [[
SHULKER OS TERMS OF SERVICE  (v]] .. TOS_VERSION .. [[)

1. What this is
Shulker OS is a hobby operating system for OpenComputers II computers in Minecraft, built on Sedna Linux. It is provided for fun, as-is.

2. Your computer
Setup does not erase anything. It changes this computer's name, password, network and role, and starts the services that role needs. Back up what you care about anyway.

3. Passwords and secrets
Passwords are stored as salted hashes, the swarm token and any API key in files only root can read. This is game-level protection: anyone who can read the world save can read or change them. Do not reuse a real-life password.

4. Network
Shulker OS connects to GitHub to update itself, and only if you turn it on, to api.anthropic.com for the Claude assistant, with your own API key (billed to you). HTTPS on Sedna does not verify certificates (see `man claude`). Swarm traffic between your computers is not encrypted. Nothing is sent anywhere else.

5. No warranty
There is no warranty of any kind. The authors are not liable for lost builds, lost bases, lost drones or lost sanity.

6. Changes
These terms may change in future versions. Setup will ask you again when they do.]]

local ROLES = {
  { id = "personal", label = "Personal computer", help = "Your own Linux computer: tasks, apps, internet. The usual choice." },
  { id = "main", label = "Swarm main", help = "Controls a swarm: hands out addresses, schedules jobs, shows the topology." },
  { id = "worker", label = "Swarm worker", help = "Joins a swarm and runs its jobs (or use the Swarm Node drive)." },
  { id = "base", label = "Drone base", help = "A swarm worker with network tunnel cards, linked to drones." },
  { id = "drone", label = "Drone (this is a robot)", help = "Joins the swarm through its drone base; takes commands." },
}

local function conf()
  local c = {}
  for _, line in ipairs(U.lines(CONF)) do
    local k, v = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
    if k then c[k] = v end
  end
  return c
end

local function header(step, title)
  T.clear()
  T.at(1, 1, string.rep(" ", T.W), "bright", "purple")
  T.g(2, 1, "a", "lavender", "purple")
  T.at(4, 1, "Shulker OS Setup", "bright", "purple")
  local s = step and ("step %d/%d"):format(step, STEPS) or ""
  T.at(T.W - #s - 1, 1, s, "lavender", "purple")
  if step then T.at(1, 2, string.rep("_", math.floor(T.W * step / STEPS)), "lavender") end
  T.at(3, 3, title, "lavender")
end

local function footer(text) T.at(2, T.H, text, "gray") end

---------------------------------------------------------------- steps
local function welcome()
  header(nil, "")
  T.logo(math.floor((T.W - 11) / 2), 4)
  local v = U.trim(U.read(U.home() .. "/VERSION") or U.VERSION)
  local y = 11
  local function center(text, fg) T.at(math.floor((T.W - #text) / 2) + 1, y, text, fg) y = y + 1 end
  center("Welcome to Shulker OS " .. v, "bright")
  y = y + 1
  center("Linux for your OpenComputers II computers: tasks, apps, swarms of computers,", "white")
  center("drones, dashboards and an optional Claude assistant.", "white")
  y = y + 1
  center("Setup takes a minute: terms, a name, a password and what this computer is for.", "gray")
  local x = math.floor((T.W - 34) / 2)
  x = T.button(x, y + 2, "Start setup", "enter")
  T.button(x + 2, y + 2, "Skip for now (s)", "s", "quiet")
  footer("Enter: start   s: skip (run `shulker setup` later)   mouse works too")
  T.flush()
  while true do
    local ev = T.event()
    if ev.type == "button" then return ev.key == "enter" end
    if ev.type == "key" and (ev.key == "q" or ev.key == "esc") then return false end
  end
end

local function terms()
  local lines = T.wrap(TOS, T.W - 6)
  local top = 1
  local view = T.H - 8
  while true do
    header(1, "Terms of Service")
    T.box(2, 4, T.W - 2, view + 2)
    for i = 0, view - 1 do
      local l = lines[top + i]
      if l then T.at(4, 5 + i, l, l:match("^%d%.") and "lavender" or (l:match("^SHULKER") and "bright" or "white")) end
    end
    local pct = math.floor(math.min(1, (top + view - 1) / #lines) * 100)
    T.at(T.W - 10, 4, (" %3d%% "):format(pct), "gray")
    local atEnd = top + view - 1 >= #lines
    local x = T.button(3, T.H - 2, "I accept", "a")
    x = T.button(x + 1, T.H - 2, "Decline", "d", "quiet")
    footer(atEnd and "a: accept   d: decline" or "Up/Down/PgUp/PgDn to read   a: accept   d: decline")
    T.flush()
    local ev = T.event()
    if ev.type == "button" then return ev.key == "a" end
    if ev.type == "key" then
      if ev.key == "down" or ev.key == "j" then top = math.min(top + 1, math.max(1, #lines - view + 1))
      elseif ev.key == "up" or ev.key == "k" then top = math.max(1, top - 1)
      elseif ev.key == "pgdn" or ev.key == " " then top = math.min(top + view, math.max(1, #lines - view + 1))
      elseif ev.key == "pgup" then top = math.max(1, top - view)
      elseif ev.key == "esc" then return false end
    elseif ev.type == "click" and ev.button == 64 then top = math.max(1, top - 3)
    elseif ev.type == "click" and ev.button == 65 then top = math.min(top + 3, math.max(1, #lines - view + 1)) end
  end
end

local function askName(state)
  while true do
    header(2, "Name this computer")
    T.text(3, 5, T.W - 6, "Other computers, the swarm and the prompt show this name. Letters, digits and dashes.", "white")
    T.at(3, 8, "Name:", "lavender")
    footer("Enter: next   Esc: back")
    T.flush()
    local name = T.input(10, 8, 30, state.name)
    if name == nil then return false end
    name = U.trim(name)
    if name:match("^[%w][%w%-]*$") and #name <= 30 then state.name = name return true end
    T.at(3, 10, "Use letters, digits and dashes (start with a letter or digit).", "pink")
    T.flush()
    T.event()
  end
end

local function askPassword(state)
  while true do
    header(3, "Password for root")
    T.text(3, 5, T.W - 6, "Needed for SSH and to keep others out of your computer. Leave it empty to keep the current one (Sedna starts with none).", "white")
    T.at(3, 9, "Password:", "lavender")
    T.at(3, 11, "Again:", "lavender")
    footer("Enter: next   Esc: back")
    T.flush()
    local p1 = T.input(14, 9, 30, "", true)
    if p1 == nil then return false end
    if p1 == "" then state.password = nil return true end
    local p2 = T.input(14, 11, 30, "", true)
    if p2 == nil then return false end
    if p1 == p2 and #p1 >= 4 then state.password = p1 return true end
    T.at(3, 13, p1 ~= p2 and "The two passwords differ, try again." or "At least 4 characters, please.", "pink")
    T.flush()
    T.event()
  end
end

local function askRole(state)
  header(4, "What is this computer for?")
  local sel = 1
  for i, r in ipairs(ROLES) do if r.id == state.role then sel = i end end
  footer("Up/Down or click to choose, Enter (or click again) to continue   Esc: back")
  local i = T.choose(4, 5, T.W - 8, ROLES, sel)
  if not i then return false end
  state.role = ROLES[i].id
  return true
end

local NET = {
  personal = {
    { id = "gateway", label = "Internet Gateway (automatic)", help = "Fixed address 10.0.0.x; the gateway block answers at 10.0.0.1." },
    { id = "dhcp", label = "Get an address from another computer (DHCP)", help = "A swarm main or a computer set up with `netcfg wizard`." },
    { id = "none", label = "No network for now", help = "Set it up later with `netcfg`." },
  },
}

local function askNetwork(state)
  header(5, "Network")
  if state.role == "main" then
    T.text(3, 5, T.W - 6, "As the swarm main this computer gets the fixed address 10.42.0.1 and hands out addresses (10.42.0.100-250) to the others. An Internet Gateway on the same network is reached at 10.42.0.254.", "white")
    state.net = "swarm"
    T.at(3, 10, "Should the main computer run jobs too?", "lavender")
    footer("Up/Down, Enter   Esc: back")
    local i = T.choose(4, 12, 60, { { label = "Yes, it works like the others", help = "Best for small swarms." },
                                     { label = "No, it only manages the swarm", help = "Keeps it responsive for big swarms." } },
                       state.work and 1 or 2)
    if not i then return false end
    state.work = i == 1
    return true
  elseif state.role == "drone" then
    T.text(3, 5, T.W - 6, "Drones get their address from their drone base over the tunnel link and join the swarm through it. Put a charger where the drone starts: that is its home.", "white")
    state.net = "dhcp"
    T.button(3, 9, "Continue", "enter")
    T.button(16, 9, "Back", "esc", "quiet")
    T.flush()
    while true do local ev = T.event() if ev.type == "button" then return ev.key == "enter" end end
  elseif state.role == "worker" or state.role == "base" then
    T.text(3, 5, T.W - 6, "Workers get their address from the swarm main by DHCP and join it by themselves. The main computer must be accepting new nodes (`swarm enroll` there).", "white")
    T.at(3, 9, "Address of the swarm main:", "lavender")
    footer("Enter: next   Esc: back")
    T.flush()
    local ip = T.input(31, 9, 18, state.leader or "10.42.0.1")
    if not ip then return false end
    state.leader = U.trim(ip)
    state.net = "dhcp"
    return true
  end
  local sel = 1
  for i, n in ipairs(NET.personal) do if n.id == state.net then sel = i end end
  footer("Up/Down or click, Enter   Esc: back")
  local i = T.choose(4, 5, T.W - 8, NET.personal, sel)
  if not i then return false end
  state.net = NET.personal[i].id
  return true
end

local function askExtras(state)
  local items = {
    { key = "ssh", label = "SSH server", help = "Log in from other computers on the network (needs a password)." },
    { key = "claude", label = "Claude assistant", help = "Optional AI helper in the terminal; needs your Anthropic API key." },
  }
  local sel = 1
  while true do
    header(6, "Extras")
    for i, it in ipairs(items) do
      local y = 5 + (i - 1) * 3
      local on = state[it.key]
      T.at(4, y, (on and "[x] " or "[ ] ") .. it.label, i == sel and "bright" or "white", i == sel and "purple" or nil)
      T.at(8, y + 1, it.help, "gray")
    end
    local x = T.button(4, 13, "Continue", "enter")
    T.button(x + 1, 13, "Back", "esc", "quiet")
    footer("Up/Down, Space or click to toggle   Enter: continue   Esc: back")
    T.flush()
    local ev = T.event()
    if ev.type == "button" then return ev.key == "enter" end
    if ev.type == "key" then
      if ev.key == "up" then sel = sel > 1 and sel - 1 or #items
      elseif ev.key == "down" or ev.key == "tab" then sel = sel < #items and sel + 1 or 1
      elseif ev.key == " " then state[items[sel].key] = not state[items[sel].key] end
    elseif ev.type == "click" then
      for i, it in ipairs(items) do
        if ev.y == 5 + (i - 1) * 3 then sel = i state[it.key] = not state[it.key] end
      end
    end
  end
end

local function roleLabel(id) for _, r in ipairs(ROLES) do if r.id == id then return r.label end end return id end

local function summary(state)
  header(7, "Ready")
  local rows = {
    { "Name", state.name },
    { "Password", state.password and "will be changed" or "unchanged" },
    { "Role", roleLabel(state.role) .. (state.role == "main" and (state.work and ", runs jobs too" or ", manages only") or "") },
    { "Network", state.role == "main" and "10.42.0.1 + DHCP for the swarm" or state.role == "drone" and "DHCP from its drone base"
      or (state.role == "worker" or state.role == "base") and ("DHCP, joins " .. state.leader)
      or ({ gateway = "Internet Gateway, fixed address", dhcp = "DHCP", none = "none for now" })[state.net] },
    { "SSH", state.ssh and "on" or "off" },
    { "Claude", state.claude and "on (asks for the key on first use)" or "off" },
  }
  for i, r in ipairs(rows) do
    T.at(4, 4 + i, r[1], "lavender")
    T.at(16, 4 + i, tostring(r[2]), "bright")
  end
  local x = T.button(4, 13, "Apply", "enter")
  T.button(x + 1, 13, "Back", "esc", "quiet")
  footer("Enter: apply   Esc: back")
  T.flush()
  while true do
    local ev = T.event()
    if ev.type == "button" then return ev.key == "enter" end
  end
end

---------------------------------------------------------------- applying
local function macHost()
  -- a stable address per computer from its MAC: 10.0.0.10 .. 10.0.0.249
  local mac = U.trim(U.read("/sys/class/net/eth0/address") or "")
  local n = 0
  for b in mac:gmatch("%x%x") do n = (n * 31 + tonumber(b, 16)) % 240 end
  return 10 + n
end

local function apply(state)
  header(nil, "Setting up " .. state.name)
  local y = 5
  local function step(label, fn)
    T.at(4, y, "...  " .. label, "white")
    T.flush()
    local ok, msg = pcall(fn)
    if ok and msg ~= false then T.at(4, y, " ok ", "lime") else T.at(4, y, "FAIL", "pink") if msg then T.at(10 + #label, y, " " .. tostring(msg):sub(1, 40), "gray") end end
    y = y + 1
  end
  local bin = U.home() .. "/bin/"
  step("computer name: " .. state.name, function()
    U.write("/etc/hostname", state.name .. "\n")
    os.execute("hostname " .. U.q(state.name))
    -- keep the name resolvable for programs that look it up
    local hosts = U.read("/etc/hosts") or ""
    if not hosts:find("%s" .. state.name:gsub("%-", "%%-") .. "%s") then
      U.append("/etc/hosts", "127.0.1.1\t" .. state.name .. "\n")
    end
  end)
  if state.password then
    step("password for root", function()
      local hash = U.trim((U.capture("mkpasswd -m sha512 " .. U.q(state.password))))
      if not hash:match("^%$") then return false end
      local lines = U.lines("/etc/shadow")
      for i, l in ipairs(lines) do
        if l:match("^root:") then lines[i] = l:gsub("^root:[^:]*:", "root:" .. hash:gsub("%%", "%%%%") .. ":") end
      end
      return U.write("/etc/shadow", table.concat(lines, "\n") .. "\n", "600")
    end)
  end
  if state.role == "main" then
    step("swarm main (10.42.0.1, DHCP, job service)", function()
      local _, code = U.capture(U.q(bin .. "swarm") .. " init" .. (state.work and " --work" or ""))
      return code == 0
    end)
  elseif state.role == "worker" or state.role == "base" then
    step("swarm worker, joining " .. state.leader, function()
      local _, code = U.capture(U.q(bin .. "swarm") .. " join " .. U.q(state.leader))
      return code == 0
    end)
    if state.role == "base" then
      step("drone base (tunnel links, relay)", function()
        local _, code = U.capture(U.q(bin .. "swarm") .. " base")
        return code == 0
      end)
    end
  elseif state.role == "drone" then
    step("drone: joins the swarm through its base", function()
      local _, code = U.capture(U.q(bin .. "swarm") .. " join auto")
      return code == 0
    end)
  else
    if U.exists(require("shulker.swarm").confPath()) then
      step("leaving the swarm", function() U.capture(U.q(bin .. "swarm") .. " leave") end)
    end
    if state.net == "gateway" then
      local ip = "10.0.0." .. macHost()
      step("network " .. ip .. " via the Internet Gateway", function()
        local _, code = U.capture(U.q(bin .. "netcfg") .. " static " .. ip .. "/24 10.0.0.1 1.1.1.1")
        return code == 0
      end)
    elseif state.net == "dhcp" then
      step("network by DHCP", function() U.capture(U.q(bin .. "netcfg") .. " dhcp") end)
    end
  end
  step("SSH server " .. (state.ssh and "on" or "off"), function()
    if state.ssh then
      if not state.password and U.read("/etc/shadow"):match("^root::") then return false, "needs a password" end
      U.mkdir(U.etcdir())
      U.write(U.etcdir() .. "/ssh.enabled", "")
      os.execute("pidof dropbear >/dev/null || /etc/init.d/dropbear start >/dev/null 2>&1")
    else
      os.remove(U.etcdir() .. "/ssh.enabled")
    end
  end)
  step("Claude assistant " .. (state.claude and "on" or "off"), function() end)
  local lines = {
    "# written by shulker-setup; run `shulker setup` to change", "tos=" .. TOS_VERSION, "role=" .. state.role,
    "claude=" .. (state.claude and "on" or "off"), "done=" .. os.date("%Y-%m-%d %H:%M"),
  }
  U.mkdir(U.etcdir())
  U.write(CONF, table.concat(lines, "\n") .. "\n")
  y = y + 1
  T.at(4, y, "Done! " .. (state.role == "main" and "Power on the workers now; watch them with `swarm status` or `swarm top`." or
    state.role == "worker" and "This computer shows up in `swarm status` on the main computer." or
    "Try `shulkerfetch`, `task` and `man intro`."), "bright")
  T.button(4, y + 2, "Finish", "enter")
  T.flush()
  while true do local ev = T.event() if ev.type == "button" or ev.type == "eof" then break end end
end

---------------------------------------------------------------- main
if U.trim((U.capture("id -u"))) ~= "0" then U.die("shulker-setup: run this as root") end
if not U.isatty(0) then U.die("shulker-setup: needs a terminal") end
local old = conf()
local state = {
  name = U.trim(U.read("/etc/hostname") or "shulker"), role = old.role or "personal", net = "gateway",
  ssh = U.exists(U.etcdir() .. "/ssh.enabled"), claude = old.claude == "on", leader = "10.42.0.1",
  work = true,
}

T.start()
local ok, err = pcall(function()
  if not welcome() then
    -- skipped: remember that, so the wizard doesn't come back at every login
    if not U.exists(CONF) then
      U.mkdir(U.etcdir())
      U.write(CONF, "# setup skipped; run `shulker setup` any time\nrole=personal\nskipped=" .. os.date("%Y-%m-%d") .. "\n")
    end
    return
  end
  if not terms() then
    T.clear() T.at(3, 3, "You need to accept the terms to set up Shulker OS. Run `shulker setup` when you are ready.", "white") T.flush()
    os.execute("sleep 2")
    return
  end
  local steps = { askName, askPassword, askRole, askNetwork, askExtras, summary }
  local i = 1
  while i <= #steps do
    if steps[i](state) then i = i + 1 elseif i > 1 then i = i - 1 else return end
  end
  apply(state)
end)
T.stop()
if not ok and not tostring(err):find("interrupted") then io.stderr:write("shulker-setup: " .. tostring(err) .. "\n") os.exit(1) end
