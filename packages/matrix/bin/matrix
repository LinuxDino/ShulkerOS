#!/usr/bin/lua
-- matrix: purple digital rain (cmatrix style). Any key or Ctrl-C quits.
local ok, P = pcall(function() return { poll = require("posix.poll"), unistd = require("posix.unistd") } end)
local W, H = 80, 24
local cols = os.getenv("COLUMNS") H = tonumber(os.getenv("LINES") or "") or H W = tonumber(cols or "") or W
local chars = "0123456789abcdefABCDEF@#$%&*+=<>?"
math.randomseed(os.time())
local drops = {}
for x = 1, W do drops[x] = math.random(-H, 0) end
os.execute("stty -icanon -echo min 0 2>/dev/null")
io.write("\27[?25l\27[2J")
local function key()
  if not ok then return false end
  local n = P.poll.rpoll(0, 60)
  if n and n > 0 then P.unistd.read(0, 16) return true end
  return false
end
local run, err = pcall(function()
  while true do
    local out = {}
    for x = 1, W, 2 do
      local y = drops[x]
      if y > 0 and y <= H then
        local ch = chars:sub(math.random(#chars), math.random(#chars))
        out[#out + 1] = ("\27[%d;%dH\27[97m%s"):format(y, x, ch:sub(1, 1))
        if y > 1 then out[#out + 1] = ("\27[%d;%dH\27[95m%s"):format(y - 1, x, chars:sub(math.random(#chars)):sub(1, 1)) end
        if y > 6 then out[#out + 1] = ("\27[%d;%dH\27[35m%s"):format(y - 6, x, chars:sub(math.random(#chars)):sub(1, 1)) end
      end
      local tail = y - 14
      if tail > 0 and tail <= H then out[#out + 1] = ("\27[%d;%dH "):format(tail, x) end
      drops[x] = y + 1
      if tail > H then drops[x] = math.random(-H // 2, 0) end
    end
    io.write(table.concat(out))
    io.flush()
    if key() then break end
    if not ok then os.execute("sleep 0.1") end
  end
end)
os.execute("stty sane 2>/dev/null")
io.write("\27[0m\27[?25h\27[2J\27[H")
